Description: mindframe: RETIRED_INSTRUCTION_FILES frozen, and comments saying mindframe absorbed it from obsidian-mind #333 (#89, #90); retired and instruction files matched without case where the filesystem ignores it, win32 and darwin (#91); GEMINI.md retired only where the vault's Gemini settings read AGENTS.md, with the settings reader lifted from obsidian-mind's hygiene scan, its comments dropped before a strict parse in place of the narrow fallback, the v1 contextFileName read, and names trimmed as Gemini trims them (#104); a BOM kept, so a BOM'd settings file names nothing, as Gemini refuses it (#119)
Forwarded: https://github.com/breferrari/mindframe/issues/19
Last-Update: 2026-10-13

diff --git a/core/scripts/lib/instruction-files.ts b/core/scripts/lib/instruction-files.ts
--- a/core/scripts/lib/instruction-files.ts
+++ b/core/scripts/lib/instruction-files.ts
@@ -1,47 +1,144 @@
 /**
- * The vault's instruction files (#321). `AGENTS.md` is the one every agent
+ * The vault's instruction files (obsidian-mind #321). `AGENTS.md` is the one every agent
  * reads. A retired one left at the vault root goes wrong silently, each its
  * own way: Claude Code reads a `CLAUDE.md` in place of `AGENTS.md`, and
- * Gemini, which now reads `AGENTS.md` through `.gemini/settings.json`, never
- * loads a `GEMINI.md`, so whatever the user added there is lost. The hygiene
- * scan and `upgrade-plan` both read this list, so a file retired later is
- * retired in one place.
+ * Gemini, where `.gemini/settings.json` points it at `AGENTS.md`, never loads
+ * a `GEMINI.md`, so whatever the user added there is lost; elsewhere
+ * `GEMINI.md` is still Gemini's manual (`retiredInVault`, #104). A vault's
+ * hygiene scan and upgrade plan read this list (obsidian-mind's do), so a file
+ * retired later is retired in one place.
  */
 
+import { readFileSync, statSync } from "node:fs";
+import { join } from "node:path";
+
 export const INSTRUCTION_FILE = "AGENTS.md";
 export const CLAUDE_MD = "CLAUDE.md";
 export const GEMINI_MD = "GEMINI.md";
 
 /**
- * Gemini's settings, whose `context.fileName` points it at `AGENTS.md`. A
+ * Gemini's settings, whose `context.fileName` (or the older top-level
+ * `contextFileName`) points it at `AGENTS.md`. A
  * user's own older copy names no context file, so Gemini reads `GEMINI.md`,
  * which in the old release only says "read CLAUDE.md".
  */
 export const GEMINI_SETTINGS = ".gemini/settings.json";
 
 /**
- * The size `AGENTS.md` stays under. Measured 2026-10-06 (#321): Antigravity
+ * The size `AGENTS.md` stays under. Measured 2026-10-06 (obsidian-mind #321): Antigravity
  * 1.3.0 truncated a 36 KB `AGENTS.md` between byte 23,860 and byte 24,305,
  * silently, and Codex CLI 0.160.0 stopped consistent with a 32 KiB cap; this
- * leaves ~2 KB of margin under the first. The template's own
- * test fails at it.
+ * leaves ~2 KB of margin under the first. obsidian-mind's template test
+ * fails at it.
  */
 export const AGENTS_MD_MAX_BYTES = 22_000;
 
 /**
- * Where the hygiene scan flags a vault's own AGENTS.md: 1 KB above the
+ * Where a hygiene scan flags a vault's own AGENTS.md: 1 KB above the
  * template's cap, so a user's first additions are not a finding, and still
  * under byte 23,860, the last one Antigravity was seen to read.
  */
 export const AGENTS_MD_FLAG_BYTES = 23_000;
 
-export const RETIRED_INSTRUCTION_FILES: readonly string[] = [CLAUDE_MD, GEMINI_MD];
+/** Frozen: every extension shares one process, so none may change the list the others' checks read. */
+export const RETIRED_INSTRUCTION_FILES: readonly string[] = Object.freeze([CLAUDE_MD, GEMINI_MD]);
 
+/** `AGENTS.md` and the retired instruction files: every name an agent loads at the vault root (#91). */
+export const INSTRUCTION_FILES: readonly string[] = Object.freeze([INSTRUCTION_FILE, ...RETIRED_INSTRUCTION_FILES]);
+
 /**
- * Whether a root file name is a retired instruction file, ignoring case:
- * Windows and macOS resolve `claude.md` as `CLAUDE.md`, so an agent loads it.
+ * Whether the platform's filesystem ignores case, so `claude.md` opens
+ * `CLAUDE.md`: Windows, and macOS, whose default APFS is case-insensitive.
+ * Known gaps, read by the platform's default (#91): a case-sensitive APFS
+ * volume, and WSL on an NTFS mount (`/mnt/c`), which reports linux but ignores
+ * case. #112 probes the vault root's filesystem instead.
  */
-export function isRetiredInstructionFile(name: string): boolean {
-	const lower = name.toLowerCase();
-	return RETIRED_INSTRUCTION_FILES.some((f) => f.toLowerCase() === lower);
+export function filesystemIgnoresCase(platform: NodeJS.Platform = process.platform): boolean {
+	return platform === "win32" || platform === "darwin";
 }
+
+/** A name or path as `platform`'s filesystem compares it: lowercased where it ignores case (#91). */
+export function foldOnDisk(p: string, platform: NodeJS.Platform = process.platform): string {
+	return filesystemIgnoresCase(platform) ? p.toLowerCase() : p;
+}
+
+/** Whether two names or paths open the same file on `platform` (#91). */
+export function sameOnDisk(a: string, b: string, platform: NodeJS.Platform = process.platform): boolean {
+	return foldOnDisk(a, platform) === foldOnDisk(b, platform);
+}
+
+/** Whether `name` is one of `names` as the agent would open it on `platform`. */
+function opensAs(name: string, names: readonly string[], platform: NodeJS.Platform): boolean {
+	return names.some((f) => sameOnDisk(name, f, platform));
+}
+
+/**
+ * Whether a root file name is a retired instruction file, matched the way the
+ * agent loads it (#91): in any case where the filesystem ignores case, as
+ * Windows and macOS resolve `claude.md` as `CLAUDE.md`, and in exact case on
+ * Linux, where the agent never loads a `claude.md`. These are the names that
+ * can be retired; whether this vault has retired one is `retiredInVault`'s
+ * question (#104).
+ */
+export function isRetiredInstructionFile(name: string, platform: NodeJS.Platform = process.platform): boolean {
+	return opensAs(name, RETIRED_INSTRUCTION_FILES, platform);
+}
+
+/** Whether a root file name is `AGENTS.md` or a retired instruction file, by the same rule (#91). */
+export function isInstructionFile(name: string, platform: NodeJS.Platform = process.platform): boolean {
+	return opensAs(name, INSTRUCTION_FILES, platform);
+}
+
+/**
+ * The context files the vault's `.gemini/settings.json` names
+ * (`context.fileName`, or the older top-level `contextFileName` Gemini still
+ * migrates; a string or a list), or [] when there is none. The file is read
+ * as gemini-cli 51617c1 reads it: comments are dropped by strip-json-comments'
+ * rules, then a strict `JSON.parse`. A file that doesn't parse names nothing,
+ * because Gemini applies none of it either. A BOM is kept, so a BOM'd file
+ * doesn't parse, as Gemini refuses it (#119). Lifted from obsidian-mind's
+ * hygiene scan (#104), which falls back to a narrow read of the raw text;
+ * dropping comments instead, the v1 key, and keeping the BOM (as obsidian-mind
+ * #377 does too) are mindframe's.
+ */
+export function geminiContextFiles(vaultRoot: string): string[] {
+	const path = join(vaultRoot, GEMINI_SETTINGS);
+	try {
+		// Only a regular file: a FIFO at that path would block the hook on read.
+		if (statSync(path, { throwIfNoEntry: false })?.isFile() !== true) return [];
+		// Strings are matched first (a double quote, past escapes), so a `//` inside
+		// one is no comment; an unterminated block comment runs to the end, in one
+		// pass; a comment becomes a space, so `tr/**/ue` stays two tokens.
+		const text = readFileSync(path, "utf8")
+			.replace(/("(?:[^"\\]|\\.)*")|\/\/[^\n]*|\/\*[\s\S]*?(?:\*\/|$)/g, (_, string: string | undefined) => string ?? " ");
+		const settings = JSON.parse(text) as { context?: { fileName?: unknown }; contextFileName?: unknown } | null;
+		const names = settings?.context?.fileName ?? settings?.contextFileName;
+		// Gemini trims each name, so " AGENTS.md" names AGENTS.md there too.
+		return (Array.isArray(names) ? names : [names]).filter((n): n is string => typeof n === "string").map((n) => n.trim());
+	} catch {
+		return [];
+	}
+}
+
+/**
+ * Whether the vault's Gemini settings point Gemini at `AGENTS.md` and not at
+ * `GEMINI.md`, the names matched as Gemini opens them (#91): only then is a
+ * `GEMINI.md` retired. Without settings, or with a user's own that name no
+ * context file, `GEMINI.md` is still Gemini's manual (#104).
+ */
+export function geminiReadsAgentsMd(vaultRoot: string, platform: NodeJS.Platform = process.platform): boolean {
+	const names = geminiContextFiles(vaultRoot);
+	return opensAs(INSTRUCTION_FILE, names, platform) && !opensAs(GEMINI_MD, names, platform);
+}
+
+/**
+ * Whether a root file name is retired in this vault: `CLAUDE.md` always, and
+ * `GEMINI.md` only where Gemini reads `AGENTS.md` (#104), each matched by
+ * #91's rule. The settings are read once, when this is called; the returned
+ * check reads nothing. `isRetiredInstructionFile` stays vault-free: the
+ * frozen list of the names that can be retired.
+ */
+export function retiredInVault(vaultRoot: string, platform: NodeJS.Platform = process.platform): (name: string) => boolean {
+	const geminiRetired = geminiReadsAgentsMd(vaultRoot, platform);
+	return (name) => isRetiredInstructionFile(name, platform) && (geminiRetired || !sameOnDisk(name, GEMINI_MD, platform));
+}
