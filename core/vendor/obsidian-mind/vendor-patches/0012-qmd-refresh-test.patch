+describe("triggerDebouncedRefresh — every worker gets its vault and index (#95)", () => {
+	test("on the immediate path and on the trailing one", () => {
+		const dir = mkdtempSync(join(tmpdir(), "qmd-args-"));
+		try {
+			const sentinel = join(dir, ".qmd-refresh-sentinel");
+			const spawned: (readonly string[])[] = [];
+			const fire = () =>
+				triggerDebouncedRefresh({
+					sentinelPath: sentinel,
+					workerPath: "worker.ts",
+					debounceMs: 30_000,
+					logPrefix: "test",
+					workerArgs: workerArgsFor("/v", "idx"),
+					qmdAvailable: () => true,
+					spawnWorker: (_p, args) => spawned.push(args),
+				});
+			fire();
+			const t = (Date.now() - 10_000) / 1000;
+			utimesSync(sentinel, t, t);
+			fire();
+			assert.deepEqual(spawned[0], ["--vault=/v", "--index=idx"]);
+			assert.deepEqual(spawned[1]?.slice(-2), ["--vault=/v", "--index=idx"]);
+			assert.ok(spawned[1]?.some((a) => a.startsWith("--trailing=")));
+		} finally {
+			rmTemp(dir);
+		}
+	});
+
